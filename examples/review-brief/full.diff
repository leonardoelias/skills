diff --git a/src/shipping/cache.test.ts b/src/shipping/cache.test.ts
new file mode 100644
index 0000000..e13b8bb
--- /dev/null
+++ b/src/shipping/cache.test.ts
@@ -0,0 +1,31 @@
+import { describe, expect, it } from 'vitest'
+import { ExpiringCache, shippingKey } from './cache'
+
+describe('ExpiringCache', () => {
+  it('forgets the entry after it expires', () => {
+    let now = 0
+    const cache = new ExpiringCache<number>(1000, 10, () => now)
+    cache.write('a', 1)
+    now = 1000
+    expect(cache.read('a')).toBeUndefined()
+  })
+
+  it('deletes the least recently used entry when full', () => {
+    const cache = new ExpiringCache<number>(1000, 2, () => 0)
+    cache.write('a', 1)
+    cache.write('b', 2)
+    cache.read('a')
+    cache.write('c', 3)
+    expect(cache.read('a')).toBe(1)
+    expect(cache.read('b')).toBeUndefined()
+  })
+})
+
+describe('shippingKey', () => {
+  it.each([
+    ['01310100', 500, '01310:1'],
+    ['01310999', 501, '01310:2'],
+  ])('postal code %s with %i g becomes %s', (postalCode, weight, key) => {
+    expect(shippingKey(postalCode, weight)).toBe(key)
+  })
+})
diff --git a/src/shipping/cache.ts b/src/shipping/cache.ts
new file mode 100644
index 0000000..f47d858
--- /dev/null
+++ b/src/shipping/cache.ts
@@ -0,0 +1,50 @@
+const TEN_MINUTES = 10 * 60 * 1000
+const MAX_ENTRIES = 5000
+
+type Entry<T> = { value: T; expiresAt: number }
+
+/** Keeps quotes for a short time. When full, it deletes the least recently used entry. */
+export class ExpiringCache<T> {
+  private entries = new Map<string, Entry<T>>()
+
+  constructor(
+    private ttlMs = TEN_MINUTES,
+    private max = MAX_ENTRIES,
+    private now = () => Date.now(),
+  ) {}
+
+  read(key: string): T | undefined {
+    const entry = this.entries.get(key)
+    if (!entry) return undefined
+    if (entry.expiresAt <= this.now()) {
+      this.entries.delete(key)
+      return undefined
+    }
+
+    // Reinsert so the Map keeps the order of use: the first key is the least recently used.
+    this.entries.delete(key)
+    this.entries.set(key, entry)
+    return entry.value
+  }
+
+  write(key: string, value: T): void {
+    this.entries.delete(key)
+    this.entries.set(key, { value, expiresAt: this.now() + this.ttlMs })
+    if (this.entries.size > this.max) {
+      const oldest = this.entries.keys().next().value
+      if (oldest !== undefined) this.entries.delete(oldest)
+    }
+  }
+
+  clear(): void {
+    this.entries.clear()
+  }
+}
+
+/** 500 g bands: the carrier charges the same price within each band. */
+export function shippingKey(postalCode: string, weightInGrams: number): string {
+  const band = Math.ceil(weightInGrams / 500)
+  return `${postalCode.slice(0, 5)}:${band}`
+}
+
+export const shippingCache = new ExpiringCache<{ priceInCents: number; deliveryDays: number }>()
